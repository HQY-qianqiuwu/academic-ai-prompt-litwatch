@article{Zhao2026,
  title = {Adaptive particle swarm algorithm for solving three-dimensional coordinates of infrasound sources based on acoustic field velocity potential theory},
  author = {Jiubin Zhao and Yuanxue Liu and Yunshan Bai and Ce Liang and Xinshan Chen and Le Wang and Lu Deng},
  year = {2026},
  journal = {Geomatics Natural Hazards and Risk},
  doi = {10.1080/19475705.2026.2725317},
  url = {https://doi.org/10.1080/19475705.2026.2725317},
  abstract = {Excessive external loads on rock and soil in hazard-prone areas generate low-frequency infrasound through molecular-scale friction and fracture. This infrasound serves as a precursor to geological disasters. This study presents a novel infrasound source localization method utilizing a compact 6-sensor array. From an aerodynamic perspective, this work establishes a velocity potential theory for homogeneous media in both free and half space, deriving nonlinear Equations relating sound pressure, particle velocity, and velocity potential. An Adaptive Particle swarm algorithm (APSO) is proposed to efficiently solve these Equations, enabling accurate localization of the infrasound source. Simulations for single-frequency and broadband point sources were conducted, yielding 3D spatial scatter plots of source locations with acceptable accuracy. Furthermore, Sensitivity analyses and robustness tests show that the method maintains reliable accuracy even under noise interference. The method demonstrates significant value for monitoring, early warning, and advanced prevention of geological hazards.}
}

@article{Zhang2026,
  title = {Transcranial acoustoelectric brain imaging with high spatiotemporal resolution},
  author = {Hao Zhang and Guowei Chen and Xue Wang and Pu Wang and 国荣 徐 and Shenjie Ji and Jia He and Mingyu Li and Feng He and Yanqiu Zhang and Xiqi Jian and Minpeng Xu and Dong Ming},
  year = {2026},
  journal = {NeuroImage},
  doi = {10.1016/j.neuroimage.2026.122179},
  url = {https://doi.org/10.1016/j.neuroimage.2026.122179},
  abstract = {Non-invasive neuroimaging has long faced the inherent trade-off between spatial and temporal resolution. Acoustoelectric brain imaging (ABI) holds promise to bridge this gap by combining the spatial precision of focused ultrasound (millimeter-level) with the temporal resolution of electroencephalography (EEG) signals (millisecond-level). However, its transcranial application remains fundamentally challenged by skull-induced wavefront aberration and attenuation. Here, we developed a full ABI system featuring a custom 128-element ultrasound phased array. Our system integrates developed algorithms for transcranial phase and amplitude correction, which were experimentally validated through an ex vivo human skull. We demonstrate that our system enables precise intracranial focus steering (lateral error ≤ 0.2 mm), accurate source localization (error ≤ 0.8 mm), and high-fidelity waveform reconstruction (correlation coefficient > 0.84). This work addresses the fundamental challenge of skull-induced imaging quality degradation in ABI, providing algorithmic and systemic foundations for advancing non-invasive neuroimaging techniques.}
}
