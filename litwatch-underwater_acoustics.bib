@article{Yu2026,
  title = {Algorithm and Analysis of Double-Set Online Fountain Code with Limited Feedback in Underwater Acoustic Networks},
  author = {Siyuan Yu and Xiuxiu Liu and xiujuan Du and Linpu Li and Xiaojing Tian and Lei ZHAO},
  year = {2026},
  journal = {Engineering Research Express},
  doi = {10.1088/2631-8695/aea5e7},
  url = {https://doi.org/10.1088/2631-8695/aea5e7},
  abstract = {Abstract Underwater acoustic networks (UANs) are characterized by long latency, energy limitation, and high bit error rate. These characteristics result in data loss and transmission errors, which pose significant challenges to the reliable transmission of underwater data. Online fountain code (OFC), with advantages such as variable bit rate, real-time feedback, and low overhead, offer a novel technical approach to addressing this issue. According to the characteristics of UANs, using random graph theory to analyze sequential recursive online fountain code with limited feedback (SROFC-LF), we focus on two issues with SROFC-LF. One is the slow formation of the largest connected component during the build-up phase. The second is that the completely random sending and feedback strategy during the completion phase can easily cause unnecessary waiting and increase latency. This paper addresses both issues by employing a double-set encoding strategy and a state feedback strategy, and proposes a double-set online fountain code with limited feedback (DSOFC-LF). Utilizing mathematical induction and the fundamental property of trees, theoretical analysis and simulation experimentation are conducted on the number of encoding packets required by DSOFC-LF. The experimental results show that DSOFC-LF is superior to existing online fountain codes in terms of cost and the number of feedback packets. Therefore, DSOFC-LF is more suitable for resource constrained UANs.}
}

