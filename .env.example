# OpenAlex polite-pool identity (recommended)
LITWATCH_OPENALEX_EMAIL=you@example.com
LITWATCH_OPENALEX_BASE_URL=https://api.openalex.org/works

# Optional Semantic Scholar API key
LITWATCH_SEMANTIC_SCHOLAR_API_KEY=
LITWATCH_SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1/paper/search
# Anonymous access uses a shared, easily rate-limited pool. Keep off for scheduled runs.
LITWATCH_SEMANTIC_SCHOLAR_ANONYMOUS=false

# Keyless arXiv and Crossref endpoints. Add an email to use Crossref's polite pool.
LITWATCH_ARXIV_BASE_URL=https://export.arxiv.org/api/query
LITWATCH_CROSSREF_BASE_URL=https://api.crossref.org/v1/works
LITWATCH_CROSSREF_EMAIL=

# Reserved for the future IEEE Xplore provider; not runnable in v1.2
LITWATCH_IEEE_XPLORE_API_KEY=

# Optional OpenAI-compatible API. Without it, retrieval/ranking still works.
LITWATCH_LLM_API_KEY=
LITWATCH_LLM_BASE_URL=https://api.openai.com/v1
LITWATCH_LLM_MODEL=gpt-5-mini
LITWATCH_LLM_PROVIDER_KIND=cloud
LITWATCH_LLM_MAX_OUTPUT_TOKENS=2048
# Configure provider prices for cost estimates; zero is suitable only for free/local models.
LITWATCH_LLM_INPUT_COST_PER_MILLION=0.0
LITWATCH_LLM_OUTPUT_COST_PER_MILLION=0.0
# Cloud model calls are fail-closed until the user explicitly opts in.
LITWATCH_LLM_CLOUD_EGRESS_CONSENT=false
# Full-text excerpts, full text, and notes require separate cloud-egress consent.
LITWATCH_LLM_FULLTEXT_EGRESS_CONSENT=false
LITWATCH_LLM_MAX_PAYLOAD_CHARS=50000
LITWATCH_MAX_TOKENS_PER_JOB=20000
LITWATCH_MAX_COST_PER_JOB=1.0
LITWATCH_MAX_DAILY_COST=5.0
LITWATCH_MAX_CONCURRENT_LLM_JOBS=2
# Outbound and durable worker bounds used by model and PDF work.
LITWATCH_REQUEST_TIMEOUT_SECONDS=30
LITWATCH_JOB_POLL_SECONDS=1
LITWATCH_JOB_CONCURRENCY=2
LITWATCH_JOB_DEFAULT_TIMEOUT_SECONDS=300
LITWATCH_JOB_LEASE_SECONDS=300

# Optional SMTP email digest
LITWATCH_SMTP_HOST=smtp.qq.com
LITWATCH_SMTP_PORT=465
LITWATCH_SMTP_USERNAME=
LITWATCH_SMTP_PASSWORD=
LITWATCH_EMAIL_FROM=
LITWATCH_EMAIL_TO=

# Optional Zotero export (write-capable key)
LITWATCH_ZOTERO_USER_ID=
LITWATCH_ZOTERO_API_KEY=

# Runtime
LITWATCH_RUNTIME_MODE=python_default
LITWATCH_DATABASE_PATH=data/litwatch.db
LITWATCH_TOPICS_PATH=config/topics.yaml
LITWATCH_LOOKBACK_DAYS=14
LITWATCH_MAX_RESULTS_PER_SOURCE=50
LITWATCH_ANALYZE_TOP_N=8
LITWATCH_FULLTEXT_TOP_N=3
